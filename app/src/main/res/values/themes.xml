<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="TextInputLayout" parent="Base.Widget.MaterialComponents.TextInputLayout">
        <item name="hintTextAppearance">@style/TextAppearance.AppCompat.Small</item>
    </style>
    <style name="BaseThemLightNoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="textInputStyle">
            @style/TextInputLayout
        </item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="BaseThemNoActionBar" parent="Theme.MaterialComponents.NoActionBar">
        <item name="textInputStyle">
            @style/TextInputLayout
        </item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="LoginTheme" parent="BaseThemLightNoActionBar">
        <item name="colorPrimary">@color/material_indigo_700</item>
        <item name="colorPrimaryDark">@color/material_indigo_900</item>
        <item name="colorAccent">@color/material_blue_accent_700</item>
        <item name="colorSecondary">@color/material_blue_accent_700</item>
        <item name="colorControlNormal">?colorAccent</item>
        <item name="icon_color">@color/white</item>
        <item name="card_background">@color/material_light_white</item>
        <item name="textAppearanceOverline">@style/TextAppearance.MaterialComponents.Overline</item>
    </style>

    <style name="InfoTheme" parent="BaseThemLightNoActionBar">
        <item name="colorPrimary">@color/material_blue_accent_700</item>
        <item name="colorPrimaryDark">@color/material_indigo_900</item>
        <item name="colorAccent">@color/material_blue_accent_700</item>
        <item name="colorSecondary">@color/material_blue_accent_700</item>
        <item name="colorControlNormal">?colorAccent</item>
        <item name="icon_color">@color/white</item>
    </style>

    <style name="ThemeTranslucent" parent="BaseThemLightNoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>

    <style name="TextAppearance.Design.CollapsingToolbar.Expanded.LightText" parent="TextAppearance.Design.CollapsingToolbar.Expanded">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="colorPrimary">@color/white</item>
        <item name="windowSplashScreenBackground">?colorPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_drawable</item>
        <!--
        postSplashScreenTheme is intentionally omitted: it's a static XML value, but
        this app picks its real theme (Light/Dark/Amlod/Bluish/Midnight) dynamically
        at runtime from user preference via ThemeEngine.apply()/BaseActivity.setupTheme().
        Leaving it set to a fixed theme (it was @style/ThemeLight) forced the window's
        background back to Light after every splash, regardless of the theme actually
        applied, while individual views still correctly picked up the real theme -
        producing mismatched/washed-out colors. Without postSplashScreenTheme, the
        SplashScreen library just leaves the theme switch entirely to the app's own
        setTheme() call, which already runs correctly in BaseActivity.onCreate().
        -->
    </style>
</resources>